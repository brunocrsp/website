---
import Logo from './Logo.astro';
import { t, type Lang } from '../i18n';
import { href, alternateHref, type RouteKey } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const alternateLang: Lang = lang === 'fr' ? 'en' : 'fr';
const alternateLangLabel = alternateLang === 'fr' ? 'Français' : 'English';
const alternateUrl = alternateHref(Astro.url.pathname, lang, alternateLang);
const switchLanguageLabel = t(lang, 'a11y.switch_language').replace('{lang}', alternateLangLabel);

const NAV: RouteKey[] = ['home', 'why', 'product', 'protocols', 'pricing', 'contact'];
const current = Astro.url.pathname;
const isCurrent = (key: RouteKey) => current === href(lang, key);
---

<header class="sticky top-0 z-50 bg-surface/80 backdrop-blur-md border-b border-line">
  <div class="wrap flex items-center justify-between h-[68px]">
    <a href={href(lang, 'home')} class="flex items-center gap-2.5 text-ink" aria-label="Meshvise">
      <Logo class="w-[26px] h-[26px]" mode="color" />
      <span class="font-medium text-[17px] tracking-tight">Meshvise</span>
    </a>

    <nav class="hidden lg:flex items-center gap-5 xl:gap-7" aria-label="Primary">
      {NAV.map((key) => (
        <a href={href(lang, key)} class="nav-link" aria-current={isCurrent(key) ? 'page' : undefined}>
          {t(lang, `nav.${key}`)}
        </a>
      ))}
    </nav>

    <div class="hidden lg:flex items-center gap-5">
      <a href={alternateUrl} hreflang={alternateLang} lang={alternateLang} aria-label={switchLanguageLabel} class="text-[13px] text-muted hover:text-ink transition-colors">
        {alternateLangLabel}
      </a>
      <a href={href(lang, 'demo')} class="btn btn-primary">{t(lang, 'nav.demo')}</a>
    </div>

    <button id="mobile-menu-btn" type="button" class="lg:hidden text-ink-2 hover:text-ink" aria-label={t(lang, 'a11y.open_menu')} aria-expanded="false" aria-controls="mobile-menu">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/>
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden lg:hidden border-t border-line px-6 py-5 flex-col gap-4 text-[15px] bg-surface" aria-label="Mobile primary">
    {NAV.map((key) => (
      <a href={href(lang, key)} class="nav-link">{t(lang, `nav.${key}`)}</a>
    ))}
    <a href={alternateUrl} hreflang={alternateLang} lang={alternateLang} aria-label={switchLanguageLabel} class="text-[13px] text-muted">{alternateLangLabel}</a>
    <a href={href(lang, 'demo')} class="btn btn-primary justify-center mt-1">{t(lang, 'nav.demo')}</a>
  </nav>
</header>

<script is:inline define:vars={{ openLabel: t(lang, 'a11y.open_menu'), closeLabel: t(lang, 'a11y.close_menu') }}>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    const setOpen = (open) => {
      menu.classList.toggle('hidden', !open);
      menu.classList.toggle('flex', open);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? closeLabel : openLabel);
    };
    btn.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.classList.contains('hidden')) setOpen(false); });
  }
</script>
