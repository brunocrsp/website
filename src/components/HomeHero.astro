---
/**
 * Premier écran. Il dit ce qu'est Meshvise en une phrase et mène aux deux
 * suites utiles : la page Produit et la démo.
 *
 * Depuis le 2026-11-18, le site explique le produit et ne le vend plus : les
 * cinq gains animés et les deux portes (« pas encore de supervision » /
 * « elle ne suit plus ») sont retirés avec les pages Tarifs et Pourquoi
 * superviser. La capture du produit suit juste en dessous (HomeScreen).
 */
import { t, type Lang } from '../i18n';
import { href } from '../i18n/routes';
import TrendBackground from './bg/TrendBackground.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="relative overflow-hidden border-b border-line isolate">
  <TrendBackground />
  <div class="wrap relative pt-12 pb-12 md:pt-16 md:pb-16">
    <h1 class="t-hero accroche">
      <span class="block">{t(lang, 'home.hero.lead')}</span>
      <span class="block accent">{t(lang, 'home.hero.accent')}</span>
    </h1>
    <p class="sous-titre">{t(lang, 'home.hero.subtitle')}</p>
    <div class="actions">
      <a href={href(lang, 'product')} class="btn btn-primary btn-lg">{t(lang, 'home.hero.cta_product')}</a>
      <a href={href(lang, 'demo')} class="btn btn-outline btn-lg">{t(lang, 'nav.demo')}</a>
    </div>
  </div>
</section>

<style>
  .accroche { max-width: 46rem; margin: 0; }
  .accent { color: var(--color-accent); }
  .sous-titre {
    margin-top: 0.9rem;
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.5;
    color: var(--color-ink-2);
    max-width: 58ch;
  }
  .actions {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
