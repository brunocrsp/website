---
/**
 * Contact. La page où mènent tous les « Prendre contact » du site depuis le
 * 2026-09-23, et le seul formulaire de demande : licence, exploitation
 * déléguée, essai, démonstration ou autre question.
 *
 * Même grammaire que les autres pages : une accroche en deux temps dont la
 * fin est à la couleur d'accent, puis le formulaire sur sa carte blanche,
 * seul sur la page. La demande se choisit par de grandes tuiles plutôt que
 * par une liste déroulante :
 * on voit d'un regard ce qu'on peut demander. Le lien qui mène ici la choisit
 * d'office (`?sujet=licence`, `?sujet=exploitation`, `?sujet=essai`…).
 *
 * La demande elle-même (tuiles, champs, envoi direct) vit dans
 * ContactRequest, partagé avec la page Tarifs.
 */
import Base from '../../layouts/Base.astro';
import fr from '../../i18n/fr.json';
import en from '../../i18n/en.json';
import ContactRequest from '../ContactRequest.astro';
import { t, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;

const c = (lang === 'fr' ? fr : en).contact;
---

<Base lang={lang} title={t(lang, 'contact.meta.title')} description={t(lang, 'contact.meta.description')}>
  <section class="border-b border-line">
    <div class="wrap pt-8 pb-10 md:pt-10 md:pb-12">
      <h1 class="t-hero accroche">
        {c.lead} <span class="accent">{c.accent}</span>
      </h1>
      <p class="sous-titre">{c.subtitle}</p>
      <div class="corps-page">
        <ContactRequest lang={lang} />
      </div>
    </div>
  </section>
</Base>

<style>
  /* Toute la page tient dans un écran sans défiler (2026-09-23) : le titre
     sur une ligne, des tuiles compactes, trois champs sur une ligne. */
  .accroche { margin: 0; }
  .accent { color: var(--color-accent); }
  .sous-titre {
    margin-top: 0.5rem;
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.5;
    color: var(--color-ink-2);
    max-width: 52ch;
  }
  .corps-page { margin-top: 1.75rem; }
</style>
