---
/**
 * Produit. L'accueil vend, la page Produit prouve : ce que Meshvise fait de
 * vos données, capture à l'appui.
 *
 * Construite le 2026-09-23 sur la grammaire de l'accueil et de « Pourquoi
 * superviser » : une accroche en deux temps dont la fin est à la couleur
 * d'accent, sous elle un bloc graphite qui mène aux quatre chapitres du
 * titre (acquérir, historiser, alerter, montrer), puis une bande par
 * chapitre, fonds alternés. La prise pour une IA est graphite, comme la
 * section IA de l'accueil, et la page finit sur « Par où commencer ».
 *
 * La page suit la chaîne de la donnée : on la lit, on la garde, on la
 * surveille, on la calcule et on la montre, puis on trace qui a changé
 * quoi. Les capacités sans capture (vues en direct, logique ;
 * accès, exploitation) se lisent en colonnes sous leur chapitre, sans
 * image : une capture n'a de sens que si elle montre quelque chose.
 *
 * Les captures sont prises sur le parc de démonstration de Bellecombe, une
 * série par langue : le produit est traduit, la page anglaise montre donc
 * l'interface en anglais (les noms du parc restent en français, ce sont des
 * données). Reprises le 2026-10-23 sur le parc rejoué (ADR-0056), en lecture
 * seule : le script de prise refuse toute requête qui n'est pas une lecture.
 * Navigateur à 1232 × 800 px, recadrage de 976 × 610 px sans la barre
 * latérale, rendu à 1952 px de large. Les révisions sont prises à 1440 px
 * de large (recadrage 1184 × 740), seule largeur où le tableau garde ses
 * boutons de retour arrière sans défiler. Aucune retouche ni masquage : si
 * une suite e2e tourne sur la base partagée, attendre son nettoyage (ses
 * drivers « E2E-… » apparaissent dans la liste). Les indicateurs montrent
 * les cartes du parc et
 * non le tableau : sa première colonne ne reste pas en place au défilement,
 * la consommation à l'arrêt y serait sans nom de machine.
 *
 * Le synoptique (2026-10-23) est l'éditeur ouvert sur « Utilités de l'îlot
 * CN » : la section parle d'installations dessinées dans le navigateur.
 * Navigateur à 1440 × 900 px en densité 1,75, recadrage de 1176 × 735 px
 * depuis (248, 76), barre latérale exclue, bibliothèque de symboles comprise.
 * Ouvert en lecture seule, aucune requête d'écriture ne part.
 */
import Base from '../../layouts/Base.astro';
import fr from '../../i18n/fr.json';
import en from '../../i18n/en.json';
import ProtocolGrid from '../ProtocolGrid.astro';
import ProductShot from '../ProductShot.astro';
import PricingBrief from '../PricingBrief.astro';
import ProcessBackground from '../bg/ProcessBackground.astro';
import acqFr from '../../assets/screens/fr/acquisition.png';
import histFr from '../../assets/screens/fr/historisation.png';
import alarmsFr from '../../assets/screens/fr/alarmes.png';
import kpiFr from '../../assets/screens/fr/indicateurs.png';
import dashFr from '../../assets/screens/fr/tableaux.png';
import traceFr from '../../assets/screens/fr/revisions.png';
import acqEn from '../../assets/screens/en/acquisition.png';
import histEn from '../../assets/screens/en/historisation.png';
import alarmsEn from '../../assets/screens/en/alarmes.png';
import kpiEn from '../../assets/screens/en/indicateurs.png';
import dashEn from '../../assets/screens/en/tableaux.png';
import traceEn from '../../assets/screens/en/revisions.png';
import synopticFr from '../../assets/screens/fr/synoptique.png';
import synopticEn from '../../assets/screens/en/synoptique.png';
import { t, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;

const CAPTURES = {
  fr: { acq: acqFr, hist: histFr, alarms: alarmsFr, kpi: kpiFr, dash: dashFr, synoptic: synopticFr, trace: traceFr },
  en: { acq: acqEn, hist: histEn, alarms: alarmsEn, kpi: kpiEn, dash: dashEn, synoptic: synopticEn, trace: traceEn },
} as const;
const captures = CAPTURES[lang];

const p = (lang === 'fr' ? fr : en).product;
const portes = p.doors as { key: string; title: string; short: string }[];
const ias = p.assistant.ias as string[];

// Les quatre chapitres du titre, et la bande où chacun mène.
const ANCRES: Record<string, string> = {
  acquerir: 'acquisition',
  historiser: 'hist',
  alerter: 'alarms',
  montrer: 'montrer',
};
---

<Base lang={lang} title={t(lang, 'product.meta.title')} description={t(lang, 'product.meta.description')}>
  <section class="relative overflow-hidden border-b border-line isolate">
    <div class="decor absolute inset-0 -z-10 hidden lg:block"><ProcessBackground /></div>
    <div class="wrap relative pt-12 pb-12 md:pt-16 md:pb-16">
      <h1 class="t-hero accroche">
        <span class="block">{t(lang, 'product.hero.lead')}</span>
        <span class="block accent">{t(lang, 'product.hero.accent')}</span>
      </h1>
      <p class="sous-titre">{t(lang, 'product.hero.subtitle')}</p>

      <nav class="apercu dark-block relative" aria-label={t(lang, 'product.hero.nav')}>
        {portes.map((g) => (
          <a href={`#${ANCRES[g.key]}`} class="porte">
            <span class="t-section nom">{g.title}</span>
            <span class="t-body mt-2 block">{g.short}</span>
            <span class="descend" aria-hidden="true">
              <svg viewBox="0 0 20 20" width="20" height="20"><path d="M10 4 V15 M5 10.5 L10 15.5 L15 10.5" /></svg>
            </span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- Acquérir -->
  <section id="acquisition" class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="t-page">{t(lang, 'product.acq.title')}</h2>
        <p class="t-lede">{t(lang, 'product.acq.intro')}</p>
      </div>
      <ProtocolGrid lang={lang} />
      <div class="ligne mt-16">
        <div class="texte">
          <p class="corps">{t(lang, 'product.acq.after')}</p>
        </div>
        <ProductShot shot={captures.acq} alt={t(lang, 'product.shots.acq')} />
      </div>
    </div>
  </section>

  <!-- Historiser -->
  <section id="hist" class="section bg-surface border-y border-line">
    <div class="wrap ligne">
      <div class="texte">
        <h2 class="t-page">{t(lang, 'product.hist.title')}</h2>
        <p class="corps">{t(lang, 'product.hist.body')}</p>
      </div>
      <ProductShot shot={captures.hist} alt={t(lang, 'product.shots.hist')} />
    </div>
  </section>

  <!-- Alerter -->
  <section id="alarms" class="section">
    <div class="wrap ligne ligne--inverse">
      <div class="texte">
        <h2 class="t-page">{t(lang, 'product.alarms.title')}</h2>
        <p class="corps">{t(lang, 'product.alarms.body')}</p>
      </div>
      <ProductShot shot={captures.alarms} alt={t(lang, 'product.shots.alarms')} />
    </div>
  </section>

  <!-- Montrer : calculer, afficher, animer -->
  <section id="montrer" class="section bg-surface border-y border-line">
    <div class="wrap pile">
      <div id="kpi" class="ligne">
        <div class="texte">
          <h2 class="t-page">{t(lang, 'product.kpi.title')}</h2>
          <p class="corps">{t(lang, 'product.kpi.body')}</p>
        </div>
        <ProductShot shot={captures.kpi} alt={t(lang, 'product.shots.kpi')} />
      </div>
      <div id="dash" class="ligne ligne--inverse">
        <div class="texte">
          <h2 class="t-page">{t(lang, 'product.dash.title')}</h2>
          <p class="corps">{t(lang, 'product.dash.body')}</p>
        </div>
        <ProductShot shot={captures.dash} alt={t(lang, 'product.shots.dash')} />
      </div>
      <div id="synoptic" class="ligne">
        <div class="texte">
          <h2 class="t-page">{t(lang, 'product.synoptic.title')}</h2>
          <p class="corps">{t(lang, 'product.synoptic.body')}</p>
        </div>
        <ProductShot shot={captures.synoptic} alt={t(lang, 'product.shots.synoptic')} />
      </div>
      <div class="colonnes colonnes--2">
        {['live', 'logic'].map((k) => (
          <div id={k} class="colonne">
            <h3 class="t-section">{t(lang, `product.${k}.title`)}</h3>
            <p class="t-body mt-3">{t(lang, `product.${k}.body`)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tracer, sécuriser, exploiter -->
  <section id="trace" class="section">
    <div class="wrap pile">
      <div class="ligne ligne--inverse">
        <div class="texte">
          <h2 class="t-page">{t(lang, 'product.trace.title')}</h2>
          <p class="corps">{t(lang, 'product.trace.body')}</p>
        </div>
        <ProductShot shot={captures.trace} alt={t(lang, 'product.shots.trace')} />
      </div>
      <div class="colonnes colonnes--2">
        {['sec', 'ops'].map((k) => (
          <div id={k} class="colonne">
            <h3 class="t-section">{t(lang, `product.${k}.title`)}</h3>
            <p class="t-body mt-3">{t(lang, `product.${k}.body`)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- La prise pour une IA. Graphite, comme la section IA de l'accueil :
       c'est la seule capacité du produit sans équivalent chez les
       supervisions établies. La section nomme les assistants qu'une
       entreprise utilise déjà : le visiteur reconnaît le sien, et comprend
       qu'il n'a rien de nouveau à adopter. Rien n'anticipe : l'assistant de
       diagnostic et la question en langue naturelle intégrés n'existent
       pas, donc ils ne sont pas mentionnés. -->
  <section id="assistant" class="section dark-block relative overflow-hidden">
    <div class="wrap">
      <div class="section-head">
        <h2 class="t-page">{t(lang, 'product.assistant.title')}</h2>
        <p class="t-lede">{t(lang, 'product.assistant.lede')}</p>
      </div>
      <ul class="ias">
        {ias.map((n, i) => (
          <li class={`ia ${i === ias.length - 1 ? 'ia--autre' : ''}`}>{n}</li>
        ))}
      </ul>
      <div class="duo">
        <p>{t(lang, 'product.assistant.connect')}</p>
        <p>{t(lang, 'product.assistant.made')}</p>
      </div>
    </div>
  </section>

  <PricingBrief lang={lang} />
</Base>

<style>
  /* ── Accroche, comme celles de l'accueil et de « Pourquoi superviser » ── */
  .decor {
    -webkit-mask-image: linear-gradient(to right, transparent 42%, #000 72%);
    mask-image: linear-gradient(to right, transparent 42%, #000 72%);
  }
  .accroche { max-width: 46rem; margin: 0; }
  .accent { color: var(--color-accent); }
  .sous-titre {
    margin-top: 0.9rem;
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.5;
    color: var(--color-ink-2);
    max-width: 52ch;
  }
  .apercu {
    margin-top: 2.75rem;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 2px 4px rgb(22 27 35 / 0.10), 0 18px 40px -20px rgb(22 27 35 / 0.45);
  }
  .porte {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    text-decoration: none;
    color: inherit;
    transition: background-color 120ms;
  }
  .porte + .porte { border-left: 1px solid var(--color-n-700); }
  @media (min-width: 768px) { .porte { padding: 2rem 1.75rem; } }
  .porte:hover { background: rgb(255 255 255 / 0.04); }
  .nom { color: var(--color-n-0); }
  .descend {
    margin-top: auto;
    padding-top: 1.25rem;
    color: var(--color-accent-soft);
  }
  .descend svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 160ms ease;
  }
  .porte:hover .descend { color: var(--color-n-0); }
  .porte:hover .descend svg { transform: translateY(3px); }

  /* ── Bandes : un texte, une capture, en alternance ─────────────────── */
  .pile { display: grid; gap: 7rem; }
  .ligne {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 4.5rem;
    align-items: center;
  }
  .ligne--inverse { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  .ligne--inverse .texte { order: 2; }
  .corps {
    margin-top: 1.25rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-ink-2);
    max-width: 34rem;
  }
  .texte > .corps:first-child { margin-top: 0; }

  /* Les capacités sans capture, en colonnes sous leur chapitre, séparées
     par un filet comme les portes de l'accroche. */
  .colonnes {
    display: grid;
    gap: 3rem;
    padding-top: 3.5rem;
    border-top: 1px solid var(--color-line);
  }
  .colonnes--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }

  /* ── L'IA, sur fond graphite ───────────────────────────────────────── */
  /* Les assistants qu'une entreprise utilise déjà : de grandes pastilles,
     lisibles d'un regard, la dernière ouverte à tous les autres. */
  .ias {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ia {
    padding: 0.875rem 1.5rem;
    border-radius: 999px;
    border: 2px solid rgb(255 255 255 / 0.28);
    background: rgb(255 255 255 / 0.06);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-n-0);
  }
  .ia--autre {
    border-style: dashed;
    background: transparent;
    color: var(--color-accent-soft);
  }
  .duo {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3.5rem;
    margin-top: 3rem;
    padding-top: 2.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.16);
  }
  .duo p {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--color-n-300);
  }

  @media (max-width: 1023px) {
    .apercu { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .porte:nth-child(3) { border-left: 0; }
    .porte:nth-child(n + 3) { border-top: 1px solid var(--color-n-700); }
    .ligne,
    .ligne--inverse { grid-template-columns: minmax(0, 1fr); gap: 2.5rem; }
    .ligne--inverse .texte { order: 0; }
    .duo { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
    .pile { gap: 5rem; }
  }
  @media (max-width: 767px) {
    .apercu { grid-template-columns: minmax(0, 1fr); }
    .porte + .porte { border-left: 0; border-top: 1px solid var(--color-n-700); }
    .colonnes--2 { grid-template-columns: minmax(0, 1fr); gap: 2rem; }
  }
</style>
