---
/**
 * La page Démo : le formulaire qui ouvre la démo publique (depuis le
 * 2026-10-26, la démo ne s'ouvre qu'après lui), le visuel du site en
 * aperçu, et la démonstration commentée pour qui la préfère.
 */
import Base from '../../layouts/Base.astro';
import DemoAccessForm from '../DemoAccessForm.astro';
import LiveTable from '../LiveTable.astro';
import { t, type Lang } from '../../i18n';
import { href } from '../../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
---

<Base lang={lang} title={t(lang, 'demo_page.meta.title')} description={t(lang, 'demo_page.meta.description')}>
  <DemoAccessForm lang={lang} />
  <section class="wrap py-14 md:py-20">
    <p class="t-small mb-3">{t(lang, 'home.live.caption')}</p>
    <LiveTable lang={lang} />
    <p class="t-body mt-10">
      {t(lang, 'demo_page.visio')}{' '}
      <a href={href(lang, 'contact') + '?sujet=demo'} class="text-accent font-medium hover:underline">{t(lang, 'demo_page.visio_link')}</a>
    </p>
  </section>
</Base>
