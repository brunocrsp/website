---
/**
 * La capture du produit sur l'accueil, juste sous l'accroche : le visiteur
 * voit à quoi ressemble Meshvise avant de lire quoi que ce soit d'autre.
 *
 * La capture (2026-10-23) est la fenêtre entière du produit, barre latérale
 * comprise, sur le synoptique « Utilités de l'îlot CN » animé en direct :
 * le visiteur voit l'atelier en fonctionnement et toute la navigation.
 * Navigateur à 1440 × 900 px en densité 1,5, une image par langue, posée
 * en `shot` depuis la page d'accueil, dans le même cadre (ProductShot) que
 * la page Produit.
 */
import type { ImageMetadata } from 'astro';
import ProductShot from './ProductShot.astro';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  shot: ImageMetadata;
}

const { lang, shot } = Astro.props;
---

<section class="ecran-section bg-surface border-b border-line" aria-label={t(lang, 'home.screen.label')}>
  <div class="wrap">
    <ProductShot
      shot={shot}
      alt={t(lang, 'home.screen.alt')}
      sizes="(min-width: 1184px) 1104px, 100vw"
      eager
    />
  </div>
</section>

<style>
  .ecran-section { padding: 3.5rem 0 4.5rem; }
  @media (min-width: 768px) { .ecran-section { padding: 4.5rem 0 6rem; } }
</style>
