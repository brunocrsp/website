---
/**
 * V-01 · Usure de broche. Registre dépouillé.
 *
 * La valeur suit le crayon : pendant que le tracé se pose, le chiffre
 * défile jour après jour, de 2,3 à 5,1 mm/s, et passe au rouge exactement
 * quand la courbe franchit le seuil. C'est ce que fait un enregistreur.
 *
 * Ni grille, ni cartouche, ni bandeau d'acte, ni caméra, ni texte dans le
 * dessin : une courbe, un seuil, un point, une cloche, un chiffre, une
 * phrase. L'étiquette du seuil et les deux bouts de l'axe ont été retirés
 * le 2026-09-22 : la phrase du dessus dit déjà les deux.
 *
 * La série est mesurée, pas modélisée : le maximum quotidien de
 * `VIB1/RMSVelocity` (Broche CU1) sur le parc de démonstration rejoué le
 * 2026-10-23 (ADR-0056), lu par `/bi/timeseries?step=1d&agg=max`, jours de
 * production seulement (vingt-deux sur trente jours). C'est la valeur en
 * usinage : à l'arrêt, la broche lit 0,2 mm/s. Le seuil de 4,5 mm/s est
 * franchi au dix-huitième jour de production. À refaire après chaque
 * remise à zéro qui change le scénario d'usure (`bellecombe.yaml`).
 */
import { mt as t, type Lang } from './text';
import Stat from './Stat.astro';
import type { Ligne } from './Stat.astro';
import { toPoints, polylineLength, decimal } from './frame';
import './strip.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dec = (v: number, n = 1) => decimal(v, n, lang);

// ── La série, mesurée sur le parc de démonstration ─────────────────────
const serie = [
  2.26, 2.25, 2.35, 2.45, 2.56, 2.66, 2.76, 3.08, 3.2, 3.29, 3.41,
  3.56, 3.85, 3.99, 4.1, 4.19, 4.29, 4.67, 4.79, 4.87, 4.95, 5.09,
];
const JOURS = serie.length - 1;
const SEUIL = 4.5; // ISO 10816
const jFranchi = serie.findIndex((v) => v >= SEUIL);
const depuis = JOURS - jFranchi;

const lignes: Ligne[] = serie.map((v) => ({
  valeur: dec(v, 1),
  ton: v >= SEUIL ? 'crit' : 'ink',
}));

// ── La bande : l'axe est tronqué ───────────────────────────────────────
// Une échelle partant de zéro écrase une dérive de trois millimètres par
// seconde en un liseré. Elle est donc cadrée sur l'intervalle où la mesure
// vit.
const W = 720;
const H = 200;
const X0 = 6;
const X1 = 714;
const Y0 = 16;
const Y1 = 186;
const V_MIN = 1.9;
const V_MAX = 5.6;

const x = (d: number) => X0 + (d / JOURS) * (X1 - X0);
const y = (v: number) => Y1 - ((v - V_MIN) / (V_MAX - V_MIN)) * (Y1 - Y0);

const pts: Array<[number, number]> = serie.map((v, d) => [x(d), y(v)]);
const trace = toPoints(pts);
const longueur = polylineLength(pts);

const ySeuil = y(SEUIL);
const xHit = x(jFranchi);
const yHit = y(serie[jFranchi]);
---

<figure class="mvf mvs" role="img" aria-label={t(lang, 'motion.spindleStrip.alt')}>
  <Stat
    lignes={lignes}
    unite="mm/s"
    phrase={`${t(lang, 'motion.spindleStrip.caption_a')} ${depuis} ${t(lang, 'motion.spindleStrip.days')}`}
  />

  <svg viewBox={`0 0 ${W} ${H}`} class="mvs-svg" aria-hidden="true" focusable="false">
    <!-- Le seuil normalisé : il préexiste à la dérive, il arrive donc avant
         que la courbe ne l'atteigne. -->
    <g class="mvs-a" style="animation-name: sws-limit">
      <line class="mvs-limit" x1={X0} y1={ySeuil} x2={X1} y2={ySeuil} />
    </g>

    <polyline
      class="mvs-trace mvs-a mvs-lin"
      style={`animation-name: mvs-draw; --len: ${longueur.toFixed(0)}; stroke-dasharray: var(--len)`}
      points={trace}
    />

    <!-- Le franchissement. L'onde ne bat pas en boucle : elle sonne une
         fois, au moment où le crayon passe au-dessus du trait. -->
    <circle class="mvs-ping mvs-a" style="animation-name: sws-ping" cx={xHit} cy={yHit} r="6" />
    <circle class="mvs-dot mvs-a" style="animation-name: sws-dot" cx={xHit} cy={yHit} r="5" />

    <!-- L'alarme qui part. Une cloche, pas un mot : la phrase du dessus dit
         déjà ce qu'elle signale. -->
    <g transform={`translate(${xHit} ${yHit - 44})`}>
      <g class="sws-bell mvs-a" style="animation-name: sws-bell">
        <circle r="17" class="sws-bell-bg" />
        <path class="sws-bell-ic" d="M-6.5 3.5 V-1 A6.5 6.5 0 0 1 6.5 -1 V3.5 L8.5 6 H-8.5 Z" />
        <circle class="sws-bell-ic" cx="0" cy="8.6" r="2" />
        <circle class="sws-bell-ic" cx="0" cy="-8.3" r="1.5" />
      </g>
    </g>
  </svg>
</figure>

<script>
  import { observerLesFigures } from './observe';

  observerLesFigures();
</script>

<style>
  .sws-bell-bg { fill: var(--color-crit); }
  .sws-bell-ic { fill: #fff; }
  .sws-bell {
    transform-box: fill-box;
    transform-origin: center;
  }
</style>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    /* La cloche sonne juste après le franchissement : elle apparaît, puis
       balance deux fois et se pose. */
    @keyframes sws-bell {
      0%, 34.1% { opacity: 0; transform: scale(0.4) rotate(0); }
      39.1% { opacity: 1; transform: scale(1.12) rotate(0); }
      43.1% { transform: scale(1) rotate(-16deg); }
      47.1% { transform: rotate(13deg); }
      51.1% { transform: rotate(-8deg); }
      55.1%, 100% { opacity: 1; transform: scale(1) rotate(0); }
    }
    @keyframes sws-limit {
      0%, 10% { opacity: 0; transform: translateX(26px); }
      26%, 100% { opacity: 1; transform: translateX(0); }
    }
    /* Le point apparaît là où le crayon franchit réellement le trait, et
       non à la fin de la course : le franchissement tombe à 81,2 % de la
       longueur du tracé, donc à 30,8 % d'un cycle où le tracé court de
       zéro à 38 %. La valeur est calculée sur la série, pas estimée à
       l'œil : à recalculer si la série change. */
    @keyframes sws-dot {
      0%, 30.8% { opacity: 0; transform: scale(0); }
      38% { opacity: 1; transform: scale(1.4); }
      44%, 100% { opacity: 1; transform: scale(1); }
    }
    @keyframes sws-ping {
      0%, 30.8% { opacity: 0; r: 6; }
      33.1% { opacity: 0.5; r: 6; }
      54%, 100% { opacity: 0; r: 28; }
    }
  }
</style>
