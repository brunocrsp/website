---
import { t, type Lang } from '../i18n';
import { FAQ_KEYS } from '../i18n/faq-keys';

interface Props {
  lang: Lang;
  standalone?: boolean;
  /** Les questions à montrer, dans cet ordre ; toutes par défaut. */
  keys?: readonly string[];
  /** Titre de la section, à la place de « Questions fréquentes ». */
  title?: string;
  /** Bande blanche, pour alterner avec la section précédente. */
  surface?: boolean;
}

const { lang, standalone = false, keys = FAQ_KEYS, title, surface = false } = Astro.props;
const bande = standalone ? 'wrap pb-20 md:pb-28' : `section${surface ? ' bg-surface border-y border-line' : ''}`;
---

<section id="faq" class={bande}>
  <div class={standalone ? 'max-w-3xl' : 'wrap max-w-3xl'}>
    {!standalone && (
      <div class="section-head">
        <h2 class="t-page">{title ?? t(lang, 'faq.title')}</h2>
        <p class="t-lede">{t(lang, 'faq.subtitle')}</p>
      </div>
    )}
    <div class="border-t border-line">
      {keys.map((key) => (
        <details id={`faq-${key}`} class="group border-b border-line">
          <summary class="flex items-start gap-4 cursor-pointer list-none py-4 pr-2">
            <span class="mt-[7px] w-3 shrink-0 text-muted group-open:text-ink" aria-hidden="true">
              <svg viewBox="0 0 12 12" class="w-3 h-3 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 2l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span class="flex-1 font-medium text-ink text-[16px]">{t(lang, `faq.${key}.q`)}</span>
          </summary>
          <div class="pb-5 pl-7 t-body">
            <p>{t(lang, `faq.${key}.a`)}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    function applyHash() {
      var hash = window.location.hash;
      if (!hash || hash.indexOf('#faq-') !== 0) return;
      var el = document.getElementById(hash.slice(1));
      if (el && el.tagName === 'DETAILS') { el.open = true; el.scrollIntoView({ block: 'start' }); }
    }
    applyHash();
    window.addEventListener('hashchange', applyHash);
  })();
</script>
