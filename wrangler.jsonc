{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meshvise-website",
  "compatibility_date": "2026-04-23",
  "main": "src/worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Le site sert meshvise.com et www.meshvise.com : Cloudflare cree les
  // enregistrements DNS des deux domaines au premier deploiement qui porte
  // ces routes, c'est-a-dire au premier push sur master qui les contient.
  "routes": [
    { "pattern": "meshvise.com", "custom_domain": true },
    { "pattern": "www.meshvise.com", "custom_domain": true }
  ],

  // CONTACT_RATE_LIMITER: native Cloudflare Rate Limiting binding, the
  // spam shield of the contact form (3 requests per 60 s per IP, key
  // `contact:<ip>`). It was TRIAL_RATE_LIMITER, shared with /api/trial,
  // until that route was removed on 2026-10-23; the KV namespace of the
  // trial (TRIAL_DEDUPE) went with it.
  "unsafe": {
    "bindings": [
      {
        "name": "CONTACT_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": {
          "limit": 3,
          "period": 60
        }
      }
    ]
  }
}


